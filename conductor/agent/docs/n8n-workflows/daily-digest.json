{
  "name": "Conductor – Daily digest",
  "nodes": [
    {
      "id": "schedule-digest",
      "name": "Daily 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "notesInFlow": true,
      "notes": "Every day at 18:00. Adjust timezone in workflow settings if needed."
    },
    {
      "id": "exec-digest",
      "name": "Generate digest",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "command": "cd /path/to/anon-cart && python3 conductor/agent/sync-agent.py --mode digest",
        "executeOnce": true
      },
      "notesInFlow": true,
      "notes": "Replace /path/to/anon-cart with your project root. Writes conductor/reports/daily-digest-*.md and sends Slack DM if configured."
    }
  ],
  "connections": {
    "Daily 18:00": {
      "main": [
        [
          {
            "node": "Generate digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
