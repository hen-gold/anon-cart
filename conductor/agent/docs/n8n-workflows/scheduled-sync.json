{
  "name": "Conductor – Scheduled sync",
  "nodes": [
    {
      "id": "schedule-sync",
      "name": "Sun–Thu 9:00 and 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,18 * * 0-4"
            }
          ]
        }
      },
      "notesInFlow": true,
      "notes": "Twice daily Sun–Thu (9:00, 18:00) to limit n8n executions. Includes Jira sync (no webhook). Adjust timezone in workflow settings if needed."
    },
    {
      "id": "exec-scheduled",
      "name": "Run scheduled sync",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "command": "cd /path/to/anon-cart && python3 conductor/agent/sync-agent.py --mode scheduled",
        "executeOnce": true
      },
      "notesInFlow": true,
      "notes": "Replace /path/to/anon-cart with your project root. Full sync + daily digest."
    }
  ],
  "connections": {
    "Sun–Thu 9:00 and 18:00": {
      "main": [
        [
          {
            "node": "Run scheduled sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
